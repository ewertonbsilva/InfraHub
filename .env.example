# InfraHub: copie para ".env" (cp .env.example .env) e ajuste. O .env NUNCA vai para o Git.
# Todos os endereços abaixo são fictícios (faixas de documentação 192.0.2.0/24 e domínio exemplo.com).

# ---------- Aparência ----------
# Nome da sua organização, mostrado como "<ORG_NOME> · InfraHub" no título e na tela de entrada. Vazio = só "InfraHub".
ORG_NOME=

# ---------- Login (defina LDAP e/ou usuários locais; sem nenhum, o servidor não sobe) ----------

# Usuários locais: "usuario:hash,usuario2:hash2". Gere cada hash com:  npm run hash-senha -- ana.silva
LOCAL_USERS=

# LDAP por LDAPS (porta 636). Deixe LDAP_HOST vazio para não usar LDAP.
LDAP_HOST=
LDAP_PORT=636
# Base de busca dos usuários (obrigatória se LDAP_HOST estiver definido).
LDAP_BASE=ou=people,dc=exemplo,dc=com
# Molde do DN usado no bind. Padrão: uid={usuario},{base}. Ex. para outro diretório: cn={usuario},ou=pessoas,{base}
LDAP_USER_DN=uid={usuario},{base}
# Certificado da autoridade que assinou o servidor LDAP (PEM). Vazio = autoridades do sistema. A validação nunca é desligada.
# Dentro do Docker, monte o arquivo e aponte o caminho do contêiner (ex.: /app/ldap/ca.pem).
LDAP_CA=
# Só entra quem for membro deste grupo (DN completo, lido do atributo memberOf do próprio usuário).
# Vazio = QUALQUER usuário que autentique no diretório.
ALLOWED_GROUP=cn=ti,ou=groups,dc=exemplo,dc=com

# ---------- Sessão ----------
# Segredo que assina o cookie de sessão (mínimo 32 caracteres). Vazio = gerado na 1ª execução em data/.session-secret.
SESSION_SECRET=
# Sessão normal: cai após 15 min sem uso, no máximo 8 h.
IDLE_SECONDS=900
MAX_LIFE_SECONDS=28800
# "Lembrar de mim" (caixa na tela de entrada): 7 dias sem uso, no máximo 30 dias.
REMEMBER_IDLE_SECONDS=604800
REMEMBER_MAX_SECONDS=2592000

# ---------- Rede ----------
# Faixas autorizadas a abrir o InfraHub (CIDR, separadas por vírgula). Vazio = qualquer origem.
# Recomendado em rede interna. Vale também para as portas de embed.
ALLOWED_CIDRS=192.0.2.0/24,198.51.100.0/24,127.0.0.1/32
# Atrás de um proxy reverso (Nginx, Caddy...), liste o IP/faixa do proxy para o InfraHub enxergar o IP real do cliente.
# Sem isso o cabeçalho X-Forwarded-For é ignorado (um cliente poderia forjá-lo).
TRUSTED_PROXIES=

# ---------- Painéis embutidos (opcional) ----------
# "porta=url,porta=url": o InfraHub abre estas portas e repassa para o alvo sem os cabeçalhos que impedem iframe.
# ATENÇÃO: estas portas não pedem login. Use ALLOWED_CIDRS e mantenha-as só na rede de confiança.
# Depois cadastre o painel na aba "Painel" com a URL  proxy://3001  (usa o host atual na porta indicada).
EMBED_PROXIES=
# 1 = aceita certificado autoassinado dos alvos de embed (use só se necessário).
EMBED_INSECURE_TLS=0

# ---------- Uptime Kuma (opcional; habilita a aba "Links") ----------
# Endereço do Uptime Kuma visto pelo servidor do InfraHub e o "slug" da status page pública.
KUMA_BASE=
KUMA_SLUG=
# Endereço que o NAVEGADOR usa para abrir a página completa (opcional; sem ele o botão não aparece).
KUMA_PUBLIC_URL=
